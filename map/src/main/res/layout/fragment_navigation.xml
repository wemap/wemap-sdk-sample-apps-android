<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragments.NavigationFragment">

    <com.getwemap.sdk.map.WemapMapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!--
      Every control this screen floats over the map, in one container so the transparent app bar is cleared
      **once** — `insetOverlayBelowTransparentAppBar()` pads this view, and everything inside it is clear.
      Without the grouping each control needs its own call, which is what this pattern replaces.
    -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!--
          `showText="false"` is load-bearing, not tidiness: this app's theme turns the thumb label on, and
          SwitchCompat builds that layout from `textOn`/`textOff`, which are null here — it throws an NPE in
          onMeasure the moment the screen is inflated.
        -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/wheelchairSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/overlay_inset"
            android:text="@string/use_wheelchair"
            app:showText="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.getwemap.example.common.map.MapLevelsSwitcher
            android:id="@+id/levelsSwitcher"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/overlay_inset"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:selectionRequired="true"
            app:singleSelection="true"
            tools:visibility="visible" />

        <!--
          `layout_constrainedWidth` on both labels is what makes their side margins mean anything: a
          `wrap_content` view between two parent constraints overflows them silently, and each of these carries
          a line long enough to do it.

          Hidden until navigation has something to say — a label reading "Navigation info will be here" says
          nothing, and the fragment shows it on the first info update and on `NavigationEvent.Started`.
        -->
        <TextView
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:background="#80000000"
            android:text="@string/navigation_placeholder"
            android:textColor="@color/white"
            android:visibility="gone"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/wheelchairSwitch" />

        <!--
          Hidden until the first location arrives, for the same reason. The fragment shows it on the first
          coordinate and never hides it again, there being no event that says a location source stopped.
        -->
        <TextView
            android:id="@+id/userLocationTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:background="#80000000"
            android:text="@string/navigation_placeholder"
            android:textColor="@color/white"
            android:visibility="gone"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@id/buttons"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent" />

        <!--
          Four buttons in two rows rather than one: at a third of the screen each a single row wraps the labels
          mid-word. `0dp` widths with weights divide the row itself; `wrap_content` with a weight divides only
          the leftover space, which comes out unequal.
        -->
        <LinearLayout
            android:id="@+id/buttons"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/startNavigationFromUserCreatedAnnotations"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:gravity="center"
                    android:textAllCaps="false"
                    android:text="@string/start_navigation_user_created_annotations" />

                <Button
                    android:id="@+id/removeUserCreatedAnnotations"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:gravity="center"
                    android:textAllCaps="false"
                    android:text="@string/remove_user_created_annotations" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/startNavigation"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:gravity="center"
                    android:textAllCaps="false"
                    android:text="@string/start_navigation" />

                <Button
                    android:id="@+id/stopNavigation"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:gravity="center"
                    android:textAllCaps="false"
                    android:text="@string/stop_navigation" />
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
