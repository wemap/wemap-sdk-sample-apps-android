<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:glEsVersion="0x00030000" android:required="true"/>
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Offline VPS background scanning (VpsLocalForegroundService). Only needed by apps that pass a
         foregroundService config to VpsLocalLocationSource; the SDK module does not declare these.
         CAMERA is also merged in from the vps-local AAR, but a foregroundServiceType="camera" service
         requires it declared in the same manifest (lint ForegroundServicePermission), so declare it
         here explicitly too. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Camera is used for VPS scans but the app runs without one (map + other sources), so it is not
         required. Declared here (also merged from the AAR) to pair with the CAMERA permission. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WemapSDK.NoActionBar"
        tools:targetApi="35">

        <activity
            android:name=".InitialActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <meta-data
                android:name="android.app.lib_name"
                android:value="" />
        </activity>

        <!-- Offline VPS background scanning: names the SDK service so the camera stays available while
             the app is backgrounded / screen off. See VpsLocalForegroundService. -->
        <service
            android:name="com.getwemap.sdk.positioning.wemapvpslocal.VpsLocalForegroundService"
            android:foregroundServiceType="camera"
            android:exported="false" />
    </application>
</manifest>