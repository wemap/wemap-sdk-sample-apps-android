<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:startDestination="@id/InitialFragment">

    <action
        android:id="@+id/action_Anywhere_to_SettingsFragment"
        app:destination="@id/SettingsFragment" />

    <fragment
        android:id="@+id/InitialFragment"
        android:name="com.getwemap.example.map.positioning.fragments.InitialFragment"
        android:label="@string/initial_fragment_label"
        tools:layout="@layout/fragment_initial">

        <action
            android:id="@+id/action_InitialFragment_to_MapFragment"
            app:destination="@id/MapFragment" />

        <action
            android:id="@+id/action_InitialFragment_to_MapVpsFragment"
            app:destination="@id/MapVpsFragment" />


        <action
            android:id="@+id/action_InitialFragment_to_MapVpsLocalFragment"
            app:destination="@id/MapVpsLocalFragment" />

        <action
            android:id="@+id/action_InitialFragment_to_VpsLocalHistoryFragment"
            app:destination="@id/VpsLocalHistoryFragment" />
    </fragment>

    <fragment
        android:id="@+id/MapFragment"
        android:name="com.getwemap.example.map.positioning.fragments.MapFragment"
        android:label="@string/map_fragment_label"
        tools:layout="@layout/fragment_map">
    </fragment>

    <fragment
        android:id="@+id/MapVpsFragment"
        android:name="com.getwemap.example.map.positioning.fragments.MapVpsFragment"
        android:label="@string/map_vps_fragment_label"
        tools:layout="@layout/fragment_map_vps"/>


    <fragment
        android:id="@+id/MapVpsLocalFragment"
        android:name="com.getwemap.example.map.positioning.fragments.MapVpsLocalFragment"
        android:label="@string/map_vps_local_fragment_label"
        tools:layout="@layout/fragment_map_vps_local"/>

    <fragment
        android:id="@+id/VpsLocalHistoryFragment"
        android:name="com.getwemap.example.map.positioning.fragments.VpsLocalHistoryFragment"
        android:label="@string/vps_local_history_label"
        tools:layout="@layout/fragment_vps_local_history">

        <action
            android:id="@+id/action_VpsLocalHistoryFragment_to_VpsLocalHistoryMapFragment"
            app:destination="@id/VpsLocalHistoryMapFragment" />
    </fragment>

    <fragment
        android:id="@+id/VpsLocalHistoryMapFragment"
        android:name="com.getwemap.example.map.positioning.fragments.VpsLocalHistoryMapFragment"
        android:label="@string/vps_local_history_label"
        tools:layout="@layout/fragment_vps_local_history_map" />

    <fragment
        android:id="@+id/SettingsFragment"
        android:name="com.getwemap.example.map.positioning.fragments.SettingsFragment"
        android:label="@string/settings_fragment_label" />
</navigation>